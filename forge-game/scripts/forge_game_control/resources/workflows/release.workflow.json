{
  "schema_id": "forge-game://schemas/workflow-definition/1.1.0",
  "schema_version": "1.1.0",
  "workflow_id": "release",
  "version": "1.2.0",
  "start_request_schema_id": "forge-game://schemas/start-run-request/1.1.0",
  "entry_phase": "release.eligibility",
  "phases": {
    "release.eligibility": {
      "phase_id": "release.eligibility",
      "executor_role": "analyst",
      "purpose": "Check included feature, debt, dependency, license, and platform readiness.",
      "allowed_run_statuses": ["ready", "running"],
      "requires": [],
      "guards": ["project.bootstrap_ready", "release.scope_valid", "release.required_slices_complete", "sources.current"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"eligible": "release.test_plan", "blocked": "$blocked"},
      "checkpoint": true
    },
    "release.test_plan": {
      "phase_id": "release.test_plan",
      "executor_role": "test_agent",
      "purpose": "Prepare the target-platform build and release verification matrix.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["release.eligibility_valid"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "release.test_gate", "blocked": "$blocked"},
      "checkpoint": true
    },
    "release.test_gate": {
      "phase_id": "release.test_gate",
      "executor_role": "human",
      "purpose": "Approve execution of the release build and test matrix.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["release.test_plan_valid"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "release.tests", "decisions": ["run", "cancel"]},
      "transitions": {"run": "release.execute", "cancel": "$cancelled"},
      "checkpoint": true
    },
    "release.execute": {
      "phase_id": "release.execute",
      "executor_role": "test_agent",
      "purpose": "Execute approved builds and release tests through BuildRunner.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.release_tests_valid", "build_runner.healthy"],
      "capabilities": ["build.package", "build.test"],
      "allowed_actions": ["build.package", "test.gated.run"],
      "required_actions": ["build.package", "test.gated.run"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"passed": "release.verify", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "release.verify": {
      "phase_id": "release.verify",
      "executor_role": "verifier",
      "purpose": "Issue an independent release-readiness verdict.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["release.evidence_current", "verifier.fresh_context"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"release_ready": "release.acceptance", "rejected": "$blocked"},
      "checkpoint": true
    },
    "release.acceptance": {
      "phase_id": "release.acceptance",
      "executor_role": "human",
      "purpose": "Approve or reject the verified release result.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["release.readiness_gate"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "release.acceptance", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "release.finalize", "reject": "$blocked"},
      "checkpoint": true
    },
    "release.finalize": {
      "phase_id": "release.finalize",
      "executor_role": "orchestrator",
      "purpose": "Publish durable release records without uploading or distributing the build.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.release_acceptance_valid", "release.evidence_current"],
      "capabilities": ["filesystem.write", "git.write"],
      "allowed_actions": ["project.records.publish", "git.commit"],
      "required_actions": ["project.records.publish", "git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "$completed", "failed": "$blocked"},
      "checkpoint": true
    }
  }
}
