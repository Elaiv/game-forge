{
  "schema_id": "forge-game://schemas/workflow-definition/1.1.0",
  "schema_version": "1.1.0",
  "workflow_id": "refresh",
  "version": "1.4.0",
  "start_request_schema_id": "forge-game://schemas/start-run-request/1.1.0",
  "entry_phase": "refresh.discovery",
  "phases": {
    "refresh.discovery": {
      "phase_id": "refresh.discovery",
      "executor_role": "analyst",
      "purpose": "Compare current sources, project projection, and target forge-game version without mutation.",
      "allowed_run_statuses": ["ready", "running"],
      "requires": [],
      "guards": ["host.read_only_satisfied", "project.state_valid"],
      "capabilities": ["filesystem.read", "ingestion.diff"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "refresh.impact", "blocked": "$blocked"},
      "checkpoint": true
    },
    "refresh.impact": {
      "phase_id": "refresh.impact",
      "executor_role": "architect",
      "purpose": "Classify source, architecture, slice backlog, schema, workflow, state migration, and template impact.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["refresh.discovery_valid"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "refresh.reconciliation_plan", "human_decision_required": "$blocked"},
      "checkpoint": true
    },
    "refresh.reconciliation_plan": {
      "phase_id": "refresh.reconciliation_plan",
      "executor_role": "orchestrator",
      "purpose": "Build the exact ownership-aware refresh diff.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["refresh.impact_valid", "project.snapshot_current"],
      "capabilities": ["filesystem.read", "templates.render", "reconciliation.plan"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "refresh.apply_gate", "conflict": "$blocked"},
      "checkpoint": true
    },
    "refresh.apply_gate": {
      "phase_id": "refresh.apply_gate",
      "executor_role": "human",
      "purpose": "Approve the exact refresh reconciliation plan.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["reconciliation.plan_current"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "refresh.apply", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "refresh.apply", "reject": "refresh.reconciliation_plan"},
      "checkpoint": true
    },
    "refresh.apply": {
      "phase_id": "refresh.apply",
      "executor_role": "orchestrator",
      "purpose": "Apply only the approved refresh diff.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.refresh_apply_valid", "host.write_satisfied", "reconciliation.inputs_unchanged"],
      "capabilities": ["filesystem.write", "git.write"],
      "allowed_actions": ["project.patch.apply", "project.files.apply", "project.records.publish", "git.commit"],
      "required_actions": ["project.files.apply", "project.records.publish", "git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "refresh.verify", "failed": "refresh.reconciliation_plan", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "refresh.verify": {
      "phase_id": "refresh.verify",
      "executor_role": "verifier",
      "purpose": "Verify projection integrity, compatibility, and idempotence.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["refresh.apply_result_valid"],
      "capabilities": ["filesystem.read", "build.preflight"],
      "allowed_actions": ["build.preflight"],
      "required_actions": ["build.preflight"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"verified": "refresh.acceptance", "failed": "refresh.reconciliation_plan"},
      "checkpoint": true
    },
    "refresh.acceptance": {
      "phase_id": "refresh.acceptance",
      "executor_role": "human",
      "purpose": "Accept the verified refresh result.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["refresh.verification_current"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "refresh.acceptance", "decisions": ["accept", "reject"]},
      "transitions": {"accept": "$completed", "reject": "$blocked"},
      "checkpoint": true
    }
  }
}
