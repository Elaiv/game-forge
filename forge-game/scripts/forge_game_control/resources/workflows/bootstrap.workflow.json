{
  "schema_id": "forge-game://schemas/workflow-definition/1.0.0",
  "schema_version": "1.0.0",
  "workflow_id": "bootstrap",
  "version": "1.1.0",
  "start_request_schema_id": "forge-game://schemas/start-run-request/1.0.0",
  "entry_phase": "bootstrap.discovery",
  "phases": {
    "bootstrap.discovery": {
      "phase_id": "bootstrap.discovery",
      "executor_role": "analyst",
      "purpose": "Normalize sources and inventory the project without changing it.",
      "allowed_run_statuses": ["ready", "running"],
      "requires": [],
      "guards": ["host.read_only_satisfied", "inputs.bootstrap_valid"],
      "capabilities": ["filesystem.read", "ingestion.markdown", "ingestion.pdf", "ingestion.docx"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "bootstrap.architecture", "blocked": "$blocked"},
      "checkpoint": true
    },
    "bootstrap.architecture": {
      "phase_id": "bootstrap.architecture",
      "executor_role": "architect",
      "purpose": "Design the complete system architecture and measurable constraints.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.discovery_valid", "bootstrap.critical_gaps_resolved"],
      "capabilities": ["filesystem.read", "research.fetch"],
      "allowed_actions": ["network.fetch"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "bootstrap.backlog_plan", "blocked": "$blocked"},
      "checkpoint": true
    },
    "bootstrap.backlog_plan": {
      "phase_id": "bootstrap.backlog_plan",
      "executor_role": "analyst",
      "purpose": "Create the traceable feature backlog within the proposed architecture.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.architecture_draft_valid"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "bootstrap.architecture_review", "blocked": "$blocked"},
      "checkpoint": true
    },
    "bootstrap.architecture_review": {
      "phase_id": "bootstrap.architecture_review",
      "executor_role": "architect",
      "purpose": "Check backlog allocation and architecture package completeness.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.backlog_valid"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"approved": "bootstrap.architecture_gate", "changes_required": "bootstrap.architecture"},
      "checkpoint": true
    },
    "bootstrap.architecture_gate": {
      "phase_id": "bootstrap.architecture_gate",
      "executor_role": "human",
      "purpose": "Approve the complete architecture package before project mutation.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.architecture_gate_ready"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "bootstrap.architecture", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "bootstrap.reconciliation_plan", "reject": "bootstrap.architecture"},
      "checkpoint": true
    },
    "bootstrap.reconciliation_plan": {
      "phase_id": "bootstrap.reconciliation_plan",
      "executor_role": "orchestrator",
      "purpose": "Render desired project state and produce an ownership-aware diff.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.bootstrap_architecture_valid", "project.snapshot_current"],
      "capabilities": ["filesystem.read", "templates.render", "reconciliation.plan"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "bootstrap.apply_gate", "conflict": "$blocked"},
      "checkpoint": true
    },
    "bootstrap.apply_gate": {
      "phase_id": "bootstrap.apply_gate",
      "executor_role": "human",
      "purpose": "Approve the exact reconciliation plan.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["reconciliation.plan_current"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "bootstrap.apply", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "bootstrap.apply", "reject": "bootstrap.reconciliation_plan"},
      "checkpoint": true
    },
    "bootstrap.apply": {
      "phase_id": "bootstrap.apply",
      "executor_role": "orchestrator",
      "purpose": "Apply the approved project projection and infrastructure actions.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.bootstrap_apply_valid", "host.write_satisfied", "reconciliation.inputs_unchanged"],
      "capabilities": ["filesystem.write", "git.write", "build.configure", "unreal_mcp.write"],
      "allowed_actions": ["project.patch.apply", "project.files.apply", "git.configure", "build.configure", "unreal.mutate"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "bootstrap.verify", "failed": "bootstrap.reconciliation_plan", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "bootstrap.verify": {
      "phase_id": "bootstrap.verify",
      "executor_role": "verifier",
      "purpose": "Verify the scaffold, toolchain, MCP, Git/LFS, runner, CI, and projection.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.apply_result_valid"],
      "capabilities": ["filesystem.read", "build.run", "unreal_mcp.read", "git.read"],
      "allowed_actions": ["build.preflight", "unreal.query"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"verified": "bootstrap.acceptance", "failed": "bootstrap.reconciliation_plan"},
      "checkpoint": true
    },
    "bootstrap.acceptance": {
      "phase_id": "bootstrap.acceptance",
      "executor_role": "human",
      "purpose": "Accept the verified Bootstrap result.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["bootstrap.definition_of_done"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "bootstrap.acceptance", "decisions": ["accept", "reject"]},
      "transitions": {"accept": "$completed", "reject": "$blocked"},
      "checkpoint": true
    }
  }
}
