{
  "schema_id": "forge-game://schemas/workflow-definition/1.1.0",
  "schema_version": "1.1.0",
  "workflow_id": "feature",
  "version": "2.1.0",
  "start_request_schema_id": "forge-game://schemas/start-run-request/1.1.0",
  "entry_phase": "feature.eligibility",
  "phases": {
    "feature.eligibility": {
      "phase_id": "feature.eligibility",
      "executor_role": "analyst",
      "purpose": "Validate feature and delivery-slice identity, architecture freshness, source freshness, and slice prerequisites.",
      "allowed_run_statuses": ["ready", "running"],
      "requires": [],
      "guards": ["project.bootstrap_ready", "feature.id_known", "slice.id_known", "sources.current", "architecture.current", "slice.prerequisites_ready"],
      "capabilities": ["filesystem.read", "ingestion.diff"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"eligible": "feature.research_plan", "blocked": "$blocked", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.research_plan": {
      "phase_id": "feature.research_plan",
      "executor_role": "analyst",
      "purpose": "Prepare one vertical slice outcome, end-to-end scenario, touched modules, architecture delta, mandatory smoke, build-vs-buy, and implementation tasks.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["slice.eligibility_valid", "architecture.model_current", "module.catalog_current", "slice.backlog_current"],
      "capabilities": ["filesystem.read", "research.fetch"],
      "allowed_actions": ["network.fetch"],
      "required_actions": [],
      "produces": ["forge-game://schemas/slice-plan/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.architecture_review", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.architecture_review": {
      "phase_id": "feature.architecture_review",
      "executor_role": "architect",
      "purpose": "Verify the slice plan against full affected modules, approved seams, dependency boundaries, and future Roadmap pressure.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0"],
      "guards": ["slice.plan_valid", "architecture.affected_modules_reviewed"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"approved": "feature.plan_gate", "changes_required": "feature.research_plan", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.plan_gate": {
      "phase_id": "feature.plan_gate",
      "executor_role": "human",
      "purpose": "Approve the exact delivery slice, playable or enabling outcome, module path, architecture impact, mandatory smoke, build-vs-buy, and applicable content sources.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["slice.plan_gate_ready"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.slice_plan", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "feature.prepare", "reject": "feature.research_plan"},
      "checkpoint": true
    },
    "feature.prepare": {
      "phase_id": "feature.prepare",
      "executor_role": "orchestrator",
      "purpose": "Create the slice branch/worktree and acquire required LFS locks.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.slice_plan_valid", "host.write_satisfied", "git.main_protected"],
      "capabilities": ["git.write", "git_lfs.lock"],
      "allowed_actions": ["git.worktree.create", "git.lfs.lock"],
      "required_actions": ["git.worktree.create"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.engineering_rules", "lock_conflict": "$blocked", "failed": "$blocked"},
      "checkpoint": true
    },
    "feature.engineering_rules": {
      "phase_id": "feature.engineering_rules",
      "executor_role": "implementer",
      "purpose": "Read references/engineering-rules.md before code changes and publish the applicable rule IDs for the approved slice plan.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0"],
      "guards": ["feature.workspace_valid", "slice.plan_approved", "engineering.rules_current"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/engineering-rule-applicability/1.1.0"],
      "gate": null,
      "transitions": {"ready": "feature.implement", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.implement": {
      "phase_id": "feature.implement",
      "executor_role": "implementer",
      "purpose": "Implement one approved delivery slice as small preflighted atomic commits while keeping the game buildable.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/engineering-rule-applicability/1.1.0"],
      "guards": ["feature.workspace_valid", "slice.plan_approved", "lfs.locks_valid", "engineering.rules_acknowledged", "engineering.applicable_rules_recorded"],
      "capabilities": ["filesystem.write", "build.preflight", "git.write", "unreal_mcp.write"],
      "allowed_actions": ["project.patch.apply", "build.preflight", "git.commit", "unreal.mutate"],
      "required_actions": ["build.preflight", "git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"implemented": "feature.slice_smoke", "architecture_change": "feature.architecture_change", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.slice_smoke": {
      "phase_id": "feature.slice_smoke",
      "executor_role": "test_agent",
      "purpose": "Execute the approved non-waivable end-to-end slice smoke through the canonical test command and record exercised modules and evidence.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["slice.implementation_current", "slice.smoke_plan_current"],
      "capabilities": ["build.test"],
      "allowed_actions": ["test.gated.run"],
      "required_actions": ["test.gated.run"],
      "produces": ["forge-game://schemas/slice-smoke-result/1.0.0"],
      "gate": null,
      "transitions": {"passed": "feature.review", "failed": "feature.implement", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.review": {
      "phase_id": "feature.review",
      "executor_role": "reviewer",
      "purpose": "Perform independent read-only code and full affected-module architecture review after the mandatory slice smoke passes.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/slice-smoke-result/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.diff_current", "slice.smoke_passed", "reviewer.fresh_context"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"approved": "feature.test_plan", "changes_required": "feature.implement", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.architecture_change": {
      "phase_id": "feature.architecture_change",
      "executor_role": "architect",
      "purpose": "Prepare the exact systemic architecture delta, revised full architecture model, revised module catalog, ADR, and impact analysis.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.architecture_change_detected"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/architecture-delta/1.0.0", "forge-game://schemas/architecture-model/1.0.0", "forge-game://schemas/module-catalog/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.architecture_change_gate", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.architecture_change_gate": {
      "phase_id": "feature.architecture_change_gate",
      "executor_role": "human",
      "purpose": "Approve or reject the exact systemic delta and proposed architecture/module revisions before replanning the slice.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/architecture-delta/1.0.0", "forge-game://schemas/architecture-model/1.0.0", "forge-game://schemas/module-catalog/1.0.0"],
      "guards": ["feature.architecture_change_gate_ready"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.architecture_change", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "feature.research_plan", "reject": "$blocked"},
      "checkpoint": true
    },
    "feature.test_plan": {
      "phase_id": "feature.test_plan",
      "executor_role": "test_agent",
      "purpose": "Propose additional risk-based automated coverage and heavy test runs after the mandatory slice smoke has passed.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/slice-smoke-result/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.review_approved", "slice.smoke_passed"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.test_gate", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.test_gate": {
      "phase_id": "feature.test_gate",
      "executor_role": "human",
      "purpose": "Choose whether to add optional coverage now, defer it with debt, or waive it; the mandatory slice smoke cannot be waived.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.test_plan_valid"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.test_coverage", "decisions": ["cover_now", "defer", "waive_skip"]},
      "transitions": {"cover_now": "feature.test_implement", "defer": "feature.engineering_compliance", "waive_skip": "feature.engineering_compliance"},
      "checkpoint": true
    },
    "feature.test_implement": {
      "phase_id": "feature.test_implement",
      "executor_role": "implementer",
      "purpose": "Implement only the approved new test coverage.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.feature_test_cover_now_valid"],
      "capabilities": ["filesystem.write", "build.preflight", "git.write"],
      "allowed_actions": ["project.patch.apply", "build.preflight", "git.commit"],
      "required_actions": ["project.patch.apply", "build.preflight", "git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.test_execute", "implementation_failure": "feature.implement"},
      "checkpoint": true
    },
    "feature.test_execute": {
      "phase_id": "feature.test_execute",
      "executor_role": "test_agent",
      "purpose": "Execute approved coverage and heavy test sets through BuildRunner.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.tests_current", "approval.feature_test_cover_now_valid"],
      "capabilities": ["build.test"],
      "allowed_actions": ["test.gated.run"],
      "required_actions": ["test.gated.run"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"passed": "feature.engineering_compliance", "test_failure": "feature.test_implement", "implementation_failure": "feature.implement"},
      "checkpoint": true
    },
    "feature.engineering_compliance": {
      "phase_id": "feature.engineering_compliance",
      "executor_role": "verifier",
      "purpose": "Independently check the final diff against engineering-rules.md and publish the checked diff hash, applicable rule IDs, evidence, violations, and compliance verdict.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/slice-smoke-result/1.0.0", "forge-game://schemas/engineering-rule-applicability/1.1.0"],
      "guards": ["feature.diff_current", "engineering.rules_current", "verifier.fresh_context"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/engineering-compliance/1.1.0"],
      "gate": null,
      "transitions": {"compliant": "feature.verify", "violations": "feature.implement", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.verify": {
      "phase_id": "feature.verify",
      "executor_role": "verifier",
      "purpose": "Evaluate slice_complete and issue an independent delivery-slice verdict from architecture, mandatory smoke, review, coverage decision, final diff, and evidence.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/slice-plan/1.0.0", "forge-game://schemas/slice-smoke-result/1.0.0", "forge-game://schemas/engineering-compliance/1.1.0"],
      "guards": ["verifier.fresh_context", "slice.evidence_current", "slice.complete", "architecture.current", "engineering.compliance_current"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/slice-verdict/1.0.0"],
      "gate": null,
      "transitions": {"slice_verified": "feature.acceptance", "slice_verified_with_debt": "feature.acceptance", "rejected": "feature.implement"},
      "checkpoint": true
    },
    "feature.acceptance": {
      "phase_id": "feature.acceptance",
      "executor_role": "human",
      "purpose": "Accept, debt-waive merge, or reject the verified delivery-slice result.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/slice-verdict/1.0.0"],
      "guards": ["slice.verdict_current"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.slice_acceptance", "decisions": ["merge", "waive_merge", "reject"]},
      "transitions": {"merge": "feature.finalize", "waive_merge": "feature.finalize", "reject": "$blocked"},
      "checkpoint": true
    },
    "feature.finalize": {
      "phase_id": "feature.finalize",
      "executor_role": "orchestrator",
      "purpose": "Merge the accepted slice into the approved target branch.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0", "forge-game://schemas/slice-verdict/1.0.0"],
      "guards": ["approval.slice_acceptance_valid", "slice.verdict_current", "git.feature_branch_current", "lfs.objects_available"],
      "capabilities": ["git.write"],
      "allowed_actions": ["git.merge"],
      "required_actions": ["git.merge"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.publish_records", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "feature.publish_records": {
      "phase_id": "feature.publish_records",
      "executor_role": "orchestrator",
      "purpose": "Atomically publish the accepted architecture, module, backlog, traceability, and ProjectState promotion only after local integration succeeds.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0", "forge-game://schemas/slice-verdict/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["approval.slice_acceptance_valid", "slice.verdict_current", "architecture.records_current", "git.slice_merged"],
      "capabilities": ["filesystem.write"],
      "allowed_actions": ["project.records.publish"],
      "required_actions": ["project.records.publish"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.commit_records", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "feature.commit_records": {
      "phase_id": "feature.commit_records",
      "executor_role": "orchestrator",
      "purpose": "Commit exactly the five atomically published project records on the integrated target branch.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0", "forge-game://schemas/slice-verdict/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["approval.slice_acceptance_valid", "records.published", "git.main_current"],
      "capabilities": ["git.write"],
      "allowed_actions": ["git.commit"],
      "required_actions": ["git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.remote_sync", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "feature.remote_sync": {
      "phase_id": "feature.remote_sync",
      "executor_role": "orchestrator",
      "purpose": "Optionally push the fully committed local result only through an explicitly available remote provider.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["git.records_committed"],
      "capabilities": ["git.write"],
      "allowed_actions": ["git.push"],
      "required_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.cleanup", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    },
    "feature.cleanup": {
      "phase_id": "feature.cleanup",
      "executor_role": "orchestrator",
      "purpose": "Remove the exact clean merged worktree after record publication and optionally release only locks held through an explicit provider.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0", "forge-game://schemas/slice-verdict/1.0.0", "forge-game://schemas/artifact/1.0.0"],
      "guards": ["approval.slice_acceptance_valid", "git.slice_merged", "git.records_committed", "lfs.objects_available"],
      "capabilities": ["git.write", "git_lfs.unlock"],
      "allowed_actions": ["runtime.cleanup", "git.lfs.unlock"],
      "required_actions": ["runtime.cleanup"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "$completed", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    }
  }
}
