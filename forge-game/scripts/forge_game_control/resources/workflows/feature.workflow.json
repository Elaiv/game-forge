{
  "schema_id": "forge-game://schemas/workflow-definition/1.0.0",
  "schema_version": "1.0.0",
  "workflow_id": "feature",
  "version": "1.0.0",
  "start_request_schema_id": "forge-game://schemas/start-run-request/1.0.0",
  "entry_phase": "feature.eligibility",
  "phases": {
    "feature.eligibility": {
      "phase_id": "feature.eligibility",
      "executor_role": "analyst",
      "purpose": "Validate feature identity, source freshness, and prerequisites.",
      "allowed_run_statuses": ["ready", "running"],
      "requires": [],
      "guards": ["project.bootstrap_ready", "feature.id_known", "sources.current", "feature.prerequisites_ready"],
      "capabilities": ["filesystem.read", "ingestion.diff"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"eligible": "feature.research_plan", "blocked": "$blocked", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.research_plan": {
      "phase_id": "feature.research_plan",
      "executor_role": "analyst",
      "purpose": "Prepare scope, acceptance criteria, build-vs-buy, content sources, and implementation tasks.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.eligibility_valid"],
      "capabilities": ["filesystem.read", "research.fetch"],
      "allowed_actions": ["network.fetch"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.architecture_review", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.architecture_review": {
      "phase_id": "feature.architecture_review",
      "executor_role": "architect",
      "purpose": "Verify the plan against approved architecture and dependency boundaries.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.plan_valid"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"approved": "feature.plan_gate", "changes_required": "feature.research_plan", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.plan_gate": {
      "phase_id": "feature.plan_gate",
      "executor_role": "human",
      "purpose": "Approve scope, architecture impact, build-vs-buy, and applicable content sources.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.plan_gate_ready"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.plan", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "feature.prepare", "reject": "feature.research_plan"},
      "checkpoint": true
    },
    "feature.prepare": {
      "phase_id": "feature.prepare",
      "executor_role": "orchestrator",
      "purpose": "Create the feature branch/worktree and acquire required LFS locks.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.feature_plan_valid", "host.write_satisfied", "git.main_protected"],
      "capabilities": ["git.write", "git_lfs.lock"],
      "allowed_actions": ["git.worktree.create", "git.lfs.lock"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.implement", "lock_conflict": "$blocked", "failed": "$blocked"},
      "checkpoint": true
    },
    "feature.implement": {
      "phase_id": "feature.implement",
      "executor_role": "implementer",
      "purpose": "Implement approved tasks as small preflighted atomic commits.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.workspace_valid", "feature.plan_approved", "lfs.locks_valid"],
      "capabilities": ["filesystem.write", "build.preflight", "git.write", "unreal_mcp.write"],
      "allowed_actions": ["project.patch.apply", "build.preflight", "git.commit", "unreal.mutate"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"implemented": "feature.review", "architecture_change": "feature.architecture_change", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.review": {
      "phase_id": "feature.review",
      "executor_role": "reviewer",
      "purpose": "Perform independent read-only code and architecture review.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.diff_current", "reviewer.fresh_context"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"approved": "feature.test_plan", "changes_required": "feature.implement", "architecture_change": "feature.architecture_change"},
      "checkpoint": true
    },
    "feature.architecture_change": {
      "phase_id": "feature.architecture_change",
      "executor_role": "architect",
      "purpose": "Prepare ADR and impact analysis for a systemic deviation.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.architecture_change_detected"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.architecture_change_gate", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.architecture_change_gate": {
      "phase_id": "feature.architecture_change_gate",
      "executor_role": "human",
      "purpose": "Approve or reject the proposed systemic architecture change.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.architecture_change_gate_ready"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.architecture_change", "decisions": ["approve", "reject"]},
      "transitions": {"approve": "feature.research_plan", "reject": "$blocked"},
      "checkpoint": true
    },
    "feature.test_plan": {
      "phase_id": "feature.test_plan",
      "executor_role": "test_agent",
      "purpose": "Propose risk-based new coverage and gated test runs.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.review_approved"],
      "capabilities": ["filesystem.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.test_gate", "blocked": "$blocked"},
      "checkpoint": true
    },
    "feature.test_gate": {
      "phase_id": "feature.test_gate",
      "executor_role": "human",
      "purpose": "Choose whether to cover now, defer, or waive test coverage.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.test_plan_valid"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.test_coverage", "decisions": ["cover_now", "defer", "waive_skip"]},
      "transitions": {"cover_now": "feature.test_implement", "defer": "feature.verify", "waive_skip": "feature.verify"},
      "checkpoint": true
    },
    "feature.test_implement": {
      "phase_id": "feature.test_implement",
      "executor_role": "implementer",
      "purpose": "Implement only the approved new test coverage.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.feature_test_cover_now_valid"],
      "capabilities": ["filesystem.write", "build.preflight", "git.write"],
      "allowed_actions": ["project.patch.apply", "build.preflight", "git.commit"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "feature.test_execute", "implementation_failure": "feature.implement"},
      "checkpoint": true
    },
    "feature.test_execute": {
      "phase_id": "feature.test_execute",
      "executor_role": "test_agent",
      "purpose": "Execute approved coverage and heavy test sets through BuildRunner.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.tests_current", "approval.feature_test_cover_now_valid"],
      "capabilities": ["build.test"],
      "allowed_actions": ["test.gated.run"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"passed": "feature.verify", "test_failure": "feature.test_implement", "implementation_failure": "feature.implement"},
      "checkpoint": true
    },
    "feature.verify": {
      "phase_id": "feature.verify",
      "executor_role": "verifier",
      "purpose": "Issue an independent verdict from requirements, final diff, and evidence.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["verifier.fresh_context", "feature.evidence_current"],
      "capabilities": ["filesystem.read", "git.read"],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"release_ready": "feature.acceptance", "implemented_unverified": "feature.acceptance", "rejected": "feature.implement"},
      "checkpoint": true
    },
    "feature.acceptance": {
      "phase_id": "feature.acceptance",
      "executor_role": "human",
      "purpose": "Accept, waive-merge, or reject the verified feature result.",
      "allowed_run_statuses": ["running", "waiting_human"],
      "requires": ["forge-game://schemas/artifact/1.0.0"],
      "guards": ["feature.verdict_current"],
      "capabilities": [],
      "allowed_actions": [],
      "produces": ["forge-game://schemas/approval-record/1.0.0"],
      "gate": {"gate_id": "feature.acceptance", "decisions": ["merge", "waive_merge", "reject"]},
      "transitions": {"merge": "feature.finalize", "waive_merge": "feature.finalize", "reject": "$blocked"},
      "checkpoint": true
    },
    "feature.finalize": {
      "phase_id": "feature.finalize",
      "executor_role": "orchestrator",
      "purpose": "Merge the accepted result, publish durable records, and clean up locks.",
      "allowed_run_statuses": ["running"],
      "requires": ["forge-game://schemas/approval-record/1.0.0"],
      "guards": ["approval.feature_acceptance_valid", "git.feature_branch_current", "lfs.objects_available"],
      "capabilities": ["git.write", "git_lfs.unlock"],
      "allowed_actions": ["git.merge", "git.push", "git.lfs.unlock", "runtime.cleanup"],
      "produces": ["forge-game://schemas/artifact/1.0.0"],
      "gate": null,
      "transitions": {"success": "$completed", "failed": "$blocked", "unknown_effect": "$blocked"},
      "checkpoint": true
    }
  }
}
