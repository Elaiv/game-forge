{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/project-record-set/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_set_id",
    "project_id",
    "purpose",
    "base_project_state",
    "scope",
    "evidence_refs",
    "records",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/project-record-set/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "record_set_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "project_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "purpose": {"enum": ["bootstrap", "feature_slice", "refresh_migration", "release"]},
    "base_project_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "revision", "content_hash"],
      "properties": {
        "schema_id": {"enum": ["forge-game://schemas/project-state/1.1.0", "forge-game://schemas/project-state/1.2.0"]},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
      }
    },
    "scope": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_id", "slice_id", "verdict_ref"],
          "properties": {
            "feature_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "slice_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "verdict_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "record_type", "target_path", "schema_id", "artifact_ref", "document_hash", "document"],
        "properties": {
          "record_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "record_type": {"enum": ["architecture-model", "module-catalog", "slice-backlog", "traceability-graph", "project-state"]},
          "target_path": {"$ref": "#/$defs/path"},
          "schema_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "artifact_ref": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
            ]
          },
          "document_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
          "document": {"type": "object"}
        }
      }
    },
    "created_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"}
  }
}
