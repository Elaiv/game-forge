{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/phase-invocation/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "workflow_id", "phase_id", "attempt", "role", "permission_profile", "input_refs", "allowed_actions", "expected_output_schema_ids"],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/phase-invocation/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "phase_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "minLength": 1},
    "permission_profile": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}},
    "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_output_schema_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
