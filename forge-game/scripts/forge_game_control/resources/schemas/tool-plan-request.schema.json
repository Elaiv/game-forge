{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/tool-plan-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "request_id",
    "adapter_id",
    "action_id",
    "project_root",
    "targets",
    "parameters",
    "planned_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/tool-plan-request/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "request_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "adapter_id": {"enum": ["git", "git_lfs", "build", "test", "unreal_mcp"]},
    "action_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "project_root": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "forge-game://schemas/action-intent/1.0.0#/$defs/target"}
    },
    "parameters": {"type": "object"},
    "planned_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
