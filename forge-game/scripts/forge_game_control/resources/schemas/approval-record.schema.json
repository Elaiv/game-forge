{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/approval-record/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "approval_id",
    "run_id",
    "workflow_id",
    "gate_id",
    "phase_id",
    "decision",
    "scope",
    "subject_refs",
    "project_state_revision",
    "run_state_revision",
    "requested_at",
    "decided_at",
    "actor",
    "provider",
    "provenance_ref",
    "status",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/approval-record/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "gate_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "phase_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "decision": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "scope": {"type": "object"},
    "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "project_state_revision": {"type": "integer", "minimum": 0},
    "run_state_revision": {"type": "integer", "minimum": 1},
    "requested_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "decided_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "actor": {"const": "human"},
    "provider": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "provenance_ref": {"type": ["object", "null"]},
    "status": {"enum": ["active", "consumed", "invalidated", "rejected"]},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
