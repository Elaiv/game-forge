{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/approval-verification-context/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "workflow_id",
    "gate_id",
    "phase_id",
    "required_decision",
    "project_state_revision",
    "run_state_revision",
    "subject_refs",
    "action_intent",
    "verified_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/approval-verification-context/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "gate_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "phase_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "required_decision": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "project_state_revision": {"type": "integer", "minimum": 0},
    "run_state_revision": {"type": "integer", "minimum": 1},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subjectRef"}
    },
    "action_intent": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "forge-game://schemas/action-intent/1.0.0"}
      ]
    },
    "verified_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  },
  "$defs": {
    "subjectRef": {
      "oneOf": [
        {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_type", "revision", "content_hash"],
          "properties": {
            "subject_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "subject_type": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "revision": {"type": ["integer", "null"], "minimum": 1},
            "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
          }
        }
      ]
    }
  }
}
