{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/slice-model-migration-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "request_id",
    "source_project_state",
    "source_traceability_graph",
    "architecture_model",
    "architecture_model_ref",
    "module_catalog",
    "module_catalog_ref",
    "slice_backlog",
    "slice_backlog_ref",
    "slice_bindings",
    "evidence_refs",
    "migrated_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/slice-model-migration-request/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "request_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "source_project_state": {"$ref": "forge-game://schemas/project-state/1.1.0"},
    "source_traceability_graph": {"$ref": "forge-game://schemas/traceability-graph/1.0.0"},
    "architecture_model": {"$ref": "forge-game://schemas/architecture-model/1.0.0"},
    "architecture_model_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
    "module_catalog": {"$ref": "forge-game://schemas/module-catalog/1.0.0"},
    "module_catalog_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
    "slice_backlog": {"$ref": "forge-game://schemas/slice-backlog/1.0.0"},
    "slice_backlog_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
    "slice_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "task_ids", "requirement_ids"],
        "properties": {
          "slice_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
    },
    "migrated_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
