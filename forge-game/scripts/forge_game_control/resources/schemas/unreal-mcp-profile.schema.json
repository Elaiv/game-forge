{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/unreal-mcp-profile/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "profile_id",
    "profile_version",
    "provider_id",
    "server_key",
    "transport",
    "endpoint",
    "negotiated_protocol",
    "host_tool_names",
    "discovery_tools",
    "operations"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/unreal-mcp-profile/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "profile_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "provider_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "server_key": {"const": "unreal-mcp"},
    "transport": {"const": "streamable_http"},
    "endpoint": {"const": "http://127.0.0.1:8000/mcp"},
    "negotiated_protocol": {"const": "2025-11-25"},
    "host_tool_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^mcp__unreal[-_]mcp__call_tool$"}
    },
    "discovery_tools": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["list_toolsets", "describe_toolset"]}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolset_name", "tool_name", "action_id", "target_argument_keys"],
        "properties": {
          "toolset_name": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "tool_name": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "action_id": {"enum": ["unreal.query", "unreal.mutate"]},
          "target_argument_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          }
        }
      }
    }
  }
}
