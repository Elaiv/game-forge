{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/policy-context/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "evaluated_at",
    "project_root",
    "run_context",
    "host_capability_report",
    "project_policy",
    "guard_facts",
    "approval_verdicts",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/policy-context/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "evaluated_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "project_root": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workflow_id",
        "workflow_version",
        "phase_id",
        "attempt",
        "role",
        "run_status",
        "project_state_revision",
        "run_state_revision"
      ],
      "properties": {
        "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
        "workflow_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
        "phase_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "attempt": {"type": "integer", "minimum": 1},
        "role": {
          "enum": ["orchestrator", "analyst", "architect", "implementer", "test_agent", "reviewer", "verifier"]
        },
        "run_status": {"enum": ["ready", "running", "waiting_human", "blocked"]},
        "project_state_revision": {"type": "integer", "minimum": 1},
        "run_state_revision": {"type": "integer", "minimum": 1}
      }
    },
    "host_capability_report": {"$ref": "forge-game://schemas/host-capability-report/1.0.0"},
    "project_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denied_action_ids",
        "denied_action_classes",
        "allowed_path_roots",
        "protected_paths",
        "allowed_network_domains",
        "required_guard_fact_ids_by_action"
      ],
      "properties": {
        "denied_action_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "denied_action_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_path_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "protected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_network_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_guard_fact_ids_by_action": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "guard_facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence_refs"],
        "properties": {
          "status": {"enum": ["satisfied", "unsatisfied", "indeterminate"]},
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
          }
        }
      }
    },
    "approval_verdicts": {
      "type": "object",
      "additionalProperties": {"enum": ["valid", "invalid", "indeterminate"]}
    },
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
