{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/transition-record/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "transition_id",
    "run_id",
    "workflow_id",
    "workflow_version",
    "from_phase",
    "from_attempt",
    "outcome",
    "to_target",
    "result_kind",
    "result_id",
    "result_hash",
    "from_run_state_revision",
    "to_run_state_revision",
    "transitioned_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/transition-record/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "workflow_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "from_phase": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "from_attempt": {"type": "integer", "minimum": 1},
    "outcome": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "to_target": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "result_kind": {"enum": ["phase_result", "approval", "runtime"]},
    "result_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "result_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
    "from_run_state_revision": {"type": "integer", "minimum": 1},
    "to_run_state_revision": {"type": "integer", "minimum": 2},
    "transitioned_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
