{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/adapter-plan/1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "adapter_plan_id", "request_hash", "adapter_id", "action_id", "status", "subject_hashes", "targets", "reason_codes", "details", "planned_at", "content_hash"],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/adapter-plan/1.2.0"},
    "schema_version": {"const": "1.2.0"},
    "adapter_plan_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
    "request_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
    "adapter_id": {"const": "filesystem"},
    "action_id": {"const": "storage.layout.migrate"},
    "status": {"enum": ["ready", "blocked", "noop"]},
    "subject_hashes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}},
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "migration_plan_id", "migration_plan_hash"],
      "properties": {
        "project_root": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "migration_plan_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "migration_plan_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
      }
    },
    "planned_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_path", "operation", "expected_hash", "result_hash", "payload_source", "mode"],
      "properties": {
        "target_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "target_path": {"$ref": "#/$defs/path"},
        "operation": {"const": "add"},
        "expected_hash": {"type": "null"},
        "result_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
        "payload_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_key", "relative_path"],
          "properties": {
            "kind": {"const": "migration"},
            "item_key": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "relative_path": {"$ref": "#/$defs/path"}
          }
        },
        "mode": {"enum": [420, 493]}
      }
    }
  }
}
