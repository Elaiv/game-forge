{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/architecture-delta/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "feature_id",
    "slice_id",
    "base_architecture_ref",
    "base_module_catalog_ref",
    "classification",
    "changed_module_ids",
    "contract_changes",
    "adr_refs",
    "proposed_architecture_revision",
    "proposed_module_catalog_revision",
    "impact_summary"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/architecture-delta/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "feature_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "slice_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "base_architecture_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
    "base_module_catalog_ref": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"},
    "classification": {"const": "systemic"},
    "changed_module_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "contract_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_id", "contract_id", "change", "compatibility"],
        "properties": {
          "module_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "contract_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "change": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "compatibility": {"enum": ["compatible", "migration_required", "breaking"]}
        }
      }
    },
    "adr_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "proposed_architecture_revision": {"type": "integer", "minimum": 2},
    "proposed_module_catalog_revision": {"type": "integer", "minimum": 2},
    "impact_summary": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
  }
}
