{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/project-state/1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "revision",
    "previous_content_hash",
    "forge_game_version",
    "workflow_versions",
    "template_version",
    "engineering_policy",
    "unreal",
    "lifecycle_status",
    "source_baseline",
    "architecture_model_ref",
    "module_catalog_ref",
    "slice_backlog_ref",
    "refs",
    "canonical_commands",
    "feature_statuses",
    "slice_statuses",
    "updated_at"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/project-state/1.2.0"},
    "schema_version": {"const": "1.2.0"},
    "project_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_content_hash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
      ]
    },
    "forge_game_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "workflow_versions": {
      "type": "object",
      "additionalProperties": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"}
    },
    "template_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "engineering_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "catalog_version", "catalog_hash", "rules_document_hash"],
      "properties": {
        "catalog_id": {"const": "forge-game-engineering-rules"},
        "catalog_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
        "catalog_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
        "rules_document_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
      }
    },
    "unreal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_version", "toolchain_fingerprint"],
      "properties": {
        "engine_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "toolchain_fingerprint": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
      }
    },
    "lifecycle_status": {
      "enum": ["uninitialized", "bootstrap_planned", "bootstrap_ready", "active", "release_blocked", "released"]
    },
    "source_baseline": {"$ref": "#/$defs/nullableArtifactRef"},
    "architecture_model_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "module_catalog_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "slice_backlog_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "refs": {
      "type": "object",
      "additionalProperties": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
    },
    "canonical_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "feature_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": ["planned", "blocked", "in_progress", "partially_verified", "implemented_unverified", "release_ready", "rejected"]
      }
    },
    "slice_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": ["planned", "blocked", "in_progress", "verified", "verified_with_debt", "rejected"]
      }
    },
    "updated_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"}
  },
  "$defs": {
    "nullableArtifactRef": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
      ]
    }
  }
}
