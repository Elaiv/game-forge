{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/architecture-model/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "architecture_id",
    "revision",
    "previous_ref",
    "source_refs",
    "coverage",
    "detail_policy",
    "systems",
    "dependency_rules",
    "runtime_flows",
    "nfr_ids",
    "adr_refs",
    "unresolved_risks"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/architecture-model/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "architecture_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
    },
    "coverage": {"const": "full-project"},
    "detail_policy": {"const": "full-coverage-progressive-detail"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "responsibility", "module_ids", "data_ownership", "public_contracts"],
        "properties": {
          "system_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "responsibility": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "module_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          },
          "data_ownership": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          },
          "public_contracts": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "dependency_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_module_id", "to_module_id", "kind", "rationale"],
        "properties": {
          "from_module_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "to_module_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "kind": {"enum": ["build", "runtime", "data", "editor"]},
          "rationale": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
        }
      }
    },
    "runtime_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "kind", "module_path", "summary"],
        "properties": {
          "flow_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "kind": {"enum": ["gameplay", "data", "network", "persistence"]},
          "module_path": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          },
          "summary": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
        }
      }
    },
    "nfr_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "adr_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "unresolved_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    }
  }
}
