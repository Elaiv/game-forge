{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/gate-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "gate_request_id",
    "run_id",
    "workflow_id",
    "workflow_version",
    "phase_id",
    "attempt",
    "gate_id",
    "decisions",
    "subject_refs",
    "project_state_revision",
    "run_state_revision",
    "requested_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/gate-request/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "gate_request_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "workflow_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "phase_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "attempt": {"type": "integer", "minimum": 1},
    "gate_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}
    },
    "project_state_revision": {"type": "integer", "minimum": 0},
    "run_state_revision": {"type": "integer", "minimum": 2},
    "requested_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
