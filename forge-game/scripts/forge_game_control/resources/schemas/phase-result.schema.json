{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/phase-result/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "workflow_id", "phase_id", "attempt", "role", "outcome", "artifact_refs", "evidence_refs"],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/phase-result/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"enum": ["bootstrap", "feature", "refresh", "release"]},
    "phase_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "role": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/artifactRef"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}}
  }
}
