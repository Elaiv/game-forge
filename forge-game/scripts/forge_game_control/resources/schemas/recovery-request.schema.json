{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/recovery-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "mode",
    "reason",
    "expected_revision",
    "expected_hash",
    "requested_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/recovery-request/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "mode": {"enum": ["retry_phase", "cancel"]},
    "reason": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "expected_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
    "requested_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
