{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/forward-test-report/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "report_id",
    "package_version",
    "workflow_id",
    "workflow_version",
    "profile",
    "project_root",
    "uproject_path",
    "feature_id",
    "slice_id",
    "checked_at",
    "status",
    "checks",
    "blocking_check_ids",
    "warning_check_ids",
    "next_actions",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/forward-test-report/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "report_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "package_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "workflow_id": {"enum": ["bootstrap", "feature"]},
    "workflow_version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"},
    "profile": {"const": "local_text_slice"},
    "project_root": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "uproject_path": {"type": ["string", "null"]},
    "feature_id": {"type": ["string", "null"], "minLength": 1},
    "slice_id": {"type": ["string", "null"], "minLength": 1},
    "checked_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "status": {"enum": ["ready", "blocked"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "message", "evidence"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "status": {"enum": ["pass", "warn", "fail"]},
          "message": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "blocking_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
    },
    "warning_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"}
    },
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  }
}
