{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-game://schemas/source-set-manifest/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "source_set_id",
    "revision",
    "normalization_profile",
    "sources",
    "normalized_at",
    "content_hash"
  ],
  "properties": {
    "schema_id": {"const": "forge-game://schemas/source-set-manifest/1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "source_set_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
    "revision": {"type": "integer", "minimum": 1},
    "normalization_profile": {"const": "forge-game.normalization.v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "normalized_at": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/timestamp"},
    "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "canonical_location",
        "media_type",
        "original_size",
        "original_hash",
        "adapter",
        "cache_key",
        "normalized_source_ref"
      ],
      "properties": {
        "source_id": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "role": {"enum": ["gdd", "roadmap", "supplemental"]},
        "canonical_location": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
        "media_type": {"enum": ["text/markdown", "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]},
        "original_size": {"type": "integer", "minimum": 0},
        "original_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "cache_key": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
        "normalized_source_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "content_hash", "status", "fragment_count"],
          "properties": {
            "path": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/nonEmptyString"},
            "content_hash": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/hash"},
            "status": {"enum": ["valid", "needs_ocr", "unsupported"]},
            "fragment_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "version"],
      "properties": {
        "adapter_id": {"enum": ["markdown", "pdf-pypdf", "docx-openxml"]},
        "version": {"$ref": "forge-game://schemas/common/1.0.0#/$defs/semver"}
      }
    }
  }
}
